# FactoryOS InstaBox Production Node Environment Template
# Note: In production, /etc/instabox/worker.env is automatically generated
# by scripts/setup.sh with a cryptographically unique 32-byte hex secret.

# Control plane HTTPS URL (Controller box1)
CONTROL_PLANE_URL=https://controlplane.shortforge.internal

# Worker authentication secret (Must match control plane INSTABOX_WORKER_SECRET; min 16 characters)
# NEVER commit production secrets to Git!
INSTABOX_WORKER_SECRET=

# Stable worker node identity (instabox-box2 through instabox-box13; box1 and box9 are excluded)
WORKER_ID=instabox-box2

# Telemetry and polling intervals
HEARTBEAT_INTERVAL_SECONDS=15.0
POLL_INTERVAL_SECONDS=5.0
MAX_JOB_DURATION_SECONDS=1800
MIN_DISK_AVAILABLE_MB=2048

# Sandboxed workspace base directory
WORKSPACE_BASE=/data/shortforge/workspace
