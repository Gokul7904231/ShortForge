{
  "schemaVersion": "0.1.0",
  "name": "ShortForge — GitHub Source",
  "behavior": "create",
  "noteNameFormat": "{{date|date:\"YYYY-MM-DD\"}} — GitHub — {{title|safe_name}}",
  "path": "raw/github",
  "context": "{{content}}",
  "properties": [
    {
      "name": "source_url",
      "value": "{{url}}",
      "type": "text"
    },
    {
      "name": "source_title",
      "value": "{{title}}",
      "type": "text"
    },
    {
      "name": "source_type",
      "value": "github",
      "type": "text"
    },
    {
      "name": "sf_epistemic_state",
      "value": "sourced",
      "type": "text"
    },
    {
      "name": "sf_verification_state",
      "value": "unverified",
      "type": "text"
    }
  ],
  "triggers": [
    "https://github.com/"
  ],
  "noteContentFormat": "# {{title}}\n\n## Source\n{{url}}\n\n## Captured content\n{{content}}\n\n## Compilation notes\n- Repository/PR/release classification pending.\n"
}
