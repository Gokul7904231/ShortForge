# ShortForge API Provider Fabric (control plane only)
# Never commit real credentials.

# Vast.ai REST v0
VAST_API_KEY=
VAST_API_BASE_URL=https://console.vast.ai/api/v0

# RunPod REST v2
RUNPOD_API_KEY=
RUNPOD_API_BASE_URL=https://api.runpod.io/v2

# Daytona current Sandbox API
DAYTONA_API_KEY=
DAYTONA_API_BASE_URL=https://app.daytona.io/api
DAYTONA_PROXY_BASE_URL=https://proxy.app.daytona.io
DAYTONA_GPU_TYPES=H100,H200,RTX-PRO-6000,RTX-5090

# Hosted sandbox render-worker activation (optional; only when a real render command produces the declared output)
SHORTFORGE_SANDBOX_RENDER_COMMAND=
SHORTFORGE_SANDBOX_OUTPUT_PATH=/tmp/shortforge/output.mp4
SANDBOX_WORKER_CPU_CORES=4
SANDBOX_WORKER_MEMORY_MB=16384
SANDBOX_WORKER_GPU_TYPE=
SANDBOX_WORKER_GPU_COUNT=1
SANDBOX_WORKER_MAX_CONCURRENCY=1
SANDBOX_WORKER_STARTUP_SECONDS=3
SANDBOX_WORKER_TRANSFER_MBPS=1000
DAYTONA_SANDBOX_IMAGE=python:3.12
MODAL_SANDBOX_APP_NAME=shortforge-sandbox
MODAL_SANDBOX_IMAGE=python:3.12
INSTAVM_API_KEY=
INSTAVM_SNAPSHOT_ID=

# Paperspace REST v1
PAPERSPACE_API_KEY=
PAPERSPACE_API_BASE_URL=https://api.paperspace.com/v1
PAPERSPACE_TEMPLATE_ID=
PAPERSPACE_STARTUP_SCRIPT_ID=
PAPERSPACE_MACHINE_TYPES=
PAPERSPACE_REGIONS=ny2,ca1,ams1

# Modal JS SDK
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_API_APP_NAME=shortforge-api-probe
MODAL_GPU_TYPES=A100,T4

# Live verification harness (never enable by default)
SHORTFORGE_LIVE_API_PROBE=0
SHORTFORGE_API_PROVIDER=
SHORTFORGE_RENDER_PROBE_IMAGE=
SHORTFORGE_RENDER_PROBE_GPU=
SHORTFORGE_RENDER_PROBE_GPU_COUNT=1
SHORTFORGE_RENDER_PROBE_CPU=2
SHORTFORGE_RENDER_PROBE_MEMORY_MB=4096
SHORTFORGE_RENDER_PROBE_DISK_GB=20
SHORTFORGE_RENDER_PROBE_TIMEOUT_MS=300000
SHORTFORGE_RENDER_PROBE_OUTPUT=/tmp/shortforge-api-probe.mp4
SHORTFORGE_RENDER_PROBE_COMMAND=ffmpeg -hide_banner -loglevel error -f lavfi -i color=c=black:s=320x568:r=30:d=1 -f lavfi -i anullsrc=r=44100:cl=mono:d=1 -shortest -c:v libx264 -pix_fmt yuv420p -c:a aac /tmp/shortforge-api-probe.mp4
