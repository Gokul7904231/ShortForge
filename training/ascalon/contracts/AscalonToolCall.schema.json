{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shortforge.ai/schemas/ascalon/toolcall.schema.json",
  "title": "AscalonToolCall",
  "type": "object",
  "description": "Strictly typed capability/tool invocation schema for Project Ascalon",
  "required": [
    "toolCallId",
    "capabilityId",
    "version",
    "callerRole",
    "arguments",
    "environmentRestrictions",
    "trainingEligible"
  ],
  "properties": {
    "toolCallId": {
      "type": "string",
      "pattern": "^call_[a-zA-Z0-9_-]+$"
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^cap_[a-zA-Z0-9_]+$"
    },
    "version": {
      "type": "string"
    },
    "callerRole": {
      "type": "string",
      "enum": ["OVERSEER", "GUARDIAN", "SLAYER", "HEALER", "WORKER"]
    },
    "arguments": {
      "type": "object"
    },
    "leaseId": {
      "type": "string"
    },
    "fencingToken": {
      "type": "integer"
    },
    "environmentRestrictions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "trainingEligible": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
