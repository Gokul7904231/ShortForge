{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shortforge://okf/exception/v1",
  "type": "object",
  "required": [
    "exceptionId",
    "ruleRefs",
    "scope",
    "approver",
    "startsAt",
    "expiresAt",
    "compensatingControls",
    "closureEvidence",
    "status"
  ],
  "properties": {
    "exceptionId": {
      "type": "string",
      "pattern": "^EXC-[A-Z0-9-]+$"
    },
    "ruleRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^OKF\\."
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "paths"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "startsAt": {
      "type": "string"
    },
    "expiresAt": {
      "type": "string"
    },
    "compensatingControls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "closureEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "OPEN",
        "APPROVED",
        "EXPIRED",
        "CLOSED",
        "REJECTED"
      ]
    }
  },
  "additionalProperties": false
}
