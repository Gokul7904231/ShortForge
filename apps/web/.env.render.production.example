# ==============================================================================
# ShortForge — RENDER PRODUCTION ENVIRONMENT (TEMPLATE / EXAMPLE)
# ==============================================================================
# This file is a SAFE, sanitized template. It contains NO real secrets.
# It may be committed to Git. The real file is .env.render.production
# (gitignored, local-only, upload that one to Render).
#
# Runtime: Node (NOT Cloudflare Workers / OpenNext / Wrangler).
# Fill every BLANK value before uploading .env.render.production to Render.
# ==============================================================================

# 1. APP & DOMAIN CONFIGURATION
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="ShortForge"
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_BASE_URL=
CONTROL_PLANE_URL=
APP_ORIGIN=

# 2. AUTHENTICATION & BOOTSTRAP OWNER
BOOTSTRAP_OWNER_EMAIL="owner@example.com"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMeStrongPassword123!"
SESSION_SECRET_KEY=
INTERNAL_API_SECRET_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
OAUTH_STATE_SECRET=
CRON_SECRET=
ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY=
FACTORYOS_ADMIN_TOKEN=
FACTORYOS_EXECUTION_SECRET=

# 3. FIREBASE CLIENT (NEXT_PUBLIC — browser-safe)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 4. FIREBASE ADMIN (SERVER-ONLY)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# 5. SHORTFORGE BASIC AI PROVIDERS (3-Tier Auto Routing)
AI_PRIMARY_PROVIDER=GEMINI
AI_PROVIDER_ORDER=GEMINI,FALLBACK_1,FALLBACK_2
AI_MODEL_MODE=auto
MODEL_DISCOVERY_CACHE_SECONDS=300
DEFAULT_LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=auto
GEMINI_PREFERRED_MODELS=gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-pro
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY_2=

FALLBACK_1_ENABLED=true
FALLBACK_1_NAME=Groq
FALLBACK_1_API_KEY=
FALLBACK_1_MODEL=auto
FALLBACK_1_PREFERRED_MODELS=llama-3.3-70b-versatile,llama3-70b-8192
FALLBACK_1_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

FALLBACK_2_ENABLED=true
FALLBACK_2_NAME=OpenRouter
FALLBACK_2_API_KEY=
FALLBACK_2_MODEL=auto
FALLBACK_2_PREFERRED_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-r1:free
FALLBACK_2_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.7-flash
OVERSEER_API=https://generativelanguage.googleapis.com/v1beta/openai/
OVERSEER_MODEL=auto
OVERSEER_API_KEY=
NVIDIA_API_KEY=
ELEVENLABS_API_KEY=
POLLINATIONS_API_KEY=

MODEL_SELECTION_QUALITY_WEIGHT=0.40
MODEL_SELECTION_SPEED_WEIGHT=0.25
MODEL_SELECTION_COST_WEIGHT=0.15
MODEL_SELECTION_CONTEXT_WEIGHT=0.10
MODEL_SELECTION_PRIORITY_WEIGHT=0.10

# 6. BASIC QUOTA & TIMEOUTS
BASIC_GENERATION_LIMIT=5
BASIC_RENDERING_ENABLED=true
AI_REQUEST_TIMEOUT_MS=30000
AI_EXECUTION_TIMEOUT_MS=60000
AI_PROVIDER_RETRY_COUNT=1
AI_PROVIDER_COOLDOWN_SECONDS=60
AUTH_SESSION_DURATION_HOURS=24
BASIC_MONTHLY_RENDER_MINUTES_LIMIT=
BASIC_RENDER_MAX_DURATION_SECONDS=

# 7. PERSISTENT RENDER WORKER (SERVER-ONLY)
RENDER_WORKER_URL=
RENDER_WORKER_SECRET=

# 8. AMD DISTRIBUTED RENDER WORKER (OPTIONAL / SERVER-ONLY)
# Configure these on the FactoryOS control plane when AMD should participate in routing.
AMD_WORKER_URL=
AMD_WORKER_SECRET=
AMD_WORKER_ID=amd-worker-01
AMD_WORKER_MAX_JOB_SECONDS=3600
AMD_WORKER_POLL_MS=1000
AMD_MAX_INPUT_FILE_MB=250

# 9. RENDER ENGINE
NEXT_PUBLIC_RENDER_ENGINE_URL=
RENDER_ENGINE_URL=
ENABLE_GPU_RENDERING=false

# 10. CLOUDINARY
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=shortforge_renders

# 11. EMAIL / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 12. STORAGE LAYER
STORAGE_DRIVER=
PRIMARY_STORAGE_PROVIDER=google-drive
VISUAL_STORAGE_PROVIDER=local
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_DELETE_AFTER_HOURS=72
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STORAGE_QUEUE_CONCURRENCY=2
PUBLISHER_QUEUE_CONCURRENCY=1

LOCAL_CACHE_LIMIT_IMAGES=2500
LOCAL_CACHE_LIMIT_SIZE_GB=5

B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=

# 13. OBSERVABILITY & SECURITY
AI_PROVIDER_LOGGING=true
AI_PROVIDER_METRICS=true

# 14. RUNTIME PATHS (Linux / Render)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
TEMP_DIR=/tmp

# 15. EXTERNAL INTEGRATIONS
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
QUIZ_PROVIDER=
DEFAULT_VOICE_PROVIDER=
SUPERTONIC_BASE_URL=

# 16. VERSIONING
WORKFLOW_VERSION=1.0
ENGINE_VERSION=1.0
PROMPT_VERSION=1.0
STORAGE_VERSION=1.0
PUBLISHER_VERSION=1.0
RUNTIME_VERSION=1.0
RENDERER_VERSION=1.0
