{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shortforge.ai/schemas/ascalon/evidence.schema.json",
  "title": "AscalonEvidence",
  "type": "object",
  "description": "Cryptographically auditable evidence contract for Project Ascalon",
  "required": [
    "evidenceId",
    "evidenceType",
    "producer",
    "method",
    "confidence",
    "capturedAt"
  ],
  "properties": {
    "evidenceId": {
      "type": "string",
      "pattern": "^evi_[a-zA-Z0-9_-]+$"
    },
    "evidenceType": {
      "type": "string",
      "enum": [
        "CAS_FILE_DIGEST",
        "FFPROBE_STREAM_METRICS",
        "GUARDIAN_SIGNATURE",
        "POLICY_SNAPSHOT",
        "DATABASE_RECORD",
        "SYSTEM_METRIC_TELEMETRY"
      ]
    },
    "producer": {
      "type": "string"
    },
    "sourceRef": {
      "type": "string"
    },
    "sourceContentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "method": {
      "type": "string",
      "enum": ["SHA256_BYTE_HASH", "FFPROBE_PARSE", "ED25519_VERIFY", "SQLITE_WAL_READ", "HTTP_FETCH_VERIFY"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "metadata": {
      "type": "object"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
