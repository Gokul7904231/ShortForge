# ShortForge Selected MCP Fabric
# Disabled by default. Never commit credentials.

SHORTFORGE_SELECTED_MCP_ENABLED=false

# Playwright MCP
PLAYWRIGHT_MCP_ENABLED=false
PLAYWRIGHT_MCP_COMMAND=npx
PLAYWRIGHT_MCP_VERSION=
PLAYWRIGHT_MCP_ARGS_JSON=
PLAYWRIGHT_MCP_CWD=
PLAYWRIGHT_MCP_PROTOCOL_VERSION=2025-11-25
PLAYWRIGHT_MCP_NAV_ALLOWLIST=
PLAYWRIGHT_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
PLAYWRIGHT_MCP_ALLOW_INTERACTION=false
PLAYWRIGHT_MCP_TIMEOUT_MS=60000
PLAYWRIGHT_MCP_MAX_RESPONSE_BYTES=8388608

# ComfyUI MCP
COMFY_MCP_ENABLED=false
COMFY_MCP_COMMAND=comfy-mcp
COMFY_MCP_ARGS_JSON=
COMFY_MCP_CWD=
COMFY_MCP_PROJECT=
COMFY_MCP_BIN=
COMFY_MCP_PROTOCOL_VERSION=2025-11-25
COMFY_MCP_ALLOWED_ROOTS=
COMFY_MCP_LICENSE_MODE=disabled
COMFY_MCP_TIMEOUT_MS=180000
COMFY_MCP_MAX_RESPONSE_BYTES=16777216

# Qdrant MCP
QDRANT_MCP_ENABLED=false
QDRANT_MCP_COMMAND=uvx
QDRANT_MCP_ARGS_JSON=
QDRANT_MCP_CWD=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=
QDRANT_DERIVED_COLLECTION=shortforge-derived-memory
QDRANT_MCP_PROTOCOL_VERSION=2025-11-25
QDRANT_MCP_TIMEOUT_MS=30000
QDRANT_MCP_MAX_RESPONSE_BYTES=4194304
