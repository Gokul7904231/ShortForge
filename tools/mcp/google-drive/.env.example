# Authentication: choose one method.
# Service account:
GOOGLE_APPLICATION_CREDENTIALS=

# Or OAuth refresh-token auth:
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Scope posture: readonly (default) or readwrite.
GOOGLE_DRIVE_MCP_SCOPE_MODE=readonly

# Optional root folder. If unset, Drive "root" is used.
GOOGLE_DRIVE_MCP_ROOT_FOLDER_ID=

# Local filesystem controls.
# Uploads are restricted to these roots. Separate multiple roots with the platform path separator.
DRIVE_MCP_ALLOWED_UPLOAD_ROOTS=data/outbox,data/cas_storage

# Downloads are restricted to this root.
DRIVE_MCP_DOWNLOAD_ROOT=data/drive-mcp-downloads

# Safety ceiling for upload size.
DRIVE_MCP_MAX_UPLOAD_BYTES=2147483648
