# FactoryOS InstaBox Node Environment Configuration
# Control plane URL (Controller is box1)
CONTROL_PLANE_URL=https://controlplane.shortforge.internal

# Worker authentication secret (do NOT commit real secrets!)
INSTABOX_WORKER_SECRET=your_secure_instabox_secret_here

# Stable worker identity (box2, box3, ... box13; note box9 is excluded)
WORKER_ID=instabox-box2

# Polling and heartbeat intervals
HEARTBEAT_INTERVAL_SECONDS=15.0
POLL_INTERVAL_SECONDS=5.0
MAX_JOB_DURATION_SECONDS=1800
WORKSPACE_BASE=/tmp/instabox_workspace
