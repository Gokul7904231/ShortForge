  "laws": [
    {
      "id": "L1",
      "text": "Human Co-Leads > Overseer > all execution. Emergency stop beats everything."
    },
    {
      "id": "L2",
      "text": "Overseer commands and coordinates but never executes production work and never bypasses a regulator veto."
    },
    {
      "id": "L3",
      "text": "Factory-wide roles are co-equal, domain-sovereign, and are never production floors."
    },
    {
      "id": "L4",
      "text": "Guardian is per-floor sovereign; a single global capability Guardian replacing per-floor command is drift."
    },
    {
      "id": "L5",
      "text": "Auditor is not F07. Auditor examines evidence; F07 establishes release integrity. Neither replaces the other."
    },
    {
      "id": "L6",
      "text": "Slayer primary verb is investigate, not kill. Containment is bounded and capability-granted."
    },
    {
      "id": "L7",
      "text": "Treasurer obeys only Overseer for discretionary commands; immutable economic rules always apply. Guardian and Treasurer are independent gates."
    },
    {
      "id": "L8",
      "text": "Ascalon thinks for the Guardian, per-floor, advisory only; never a second Overseer."
    },
    {
      "id": "L9",
      "text": "Comms transports events; never commands, authorizes, spends, repairs, or verifies."
    },
    {
      "id": "L10",
      "text": "Advisor recommends; Instructor teaches; BDA inspects and records to Auditor; FG-Healer joints with global Healer. None self-grants authority."
    },
    {
      "id": "L11",
      "text": "F03 and F04 run in parallel and converge at F05; otherwise floors are sequential F00 to F07. Workers execute only."
    },
    {
      "id": "L12",
      "text": "No accretion: no new sovereign role without a Human-approved charter amendment."
    },
    {
      "id": "L13",
      "text": "CLAIM <= EVIDENCE and LEARNING != PROOF at every layer. Execution success is not verified success."
    }
  ],
