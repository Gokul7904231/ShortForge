{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShortForgeComponentDefinition",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "version",
    "contentHash",
    "type",
    "supportedDimensions",
    "inputSchema",
    "supportedRendererProfiles",
    "license",
    "qualificationStatus"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["container", "badge", "progress", "reveal", "cta", "transition", "icon"]
    },
    "version": { "type": "string" },
    "contentHash": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["native_pillow", "vector_svg", "raster_overlay", "motion_recipe", "remotion_composition"]
    },
    "supportedDimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["width", "height", "fps"],
        "properties": {
          "width": { "type": "integer" },
          "height": { "type": "integer" },
          "fps": { "type": "integer" }
        }
      }
    },
    "inputSchema": { "type": "object" },
    "supportedRendererProfiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["shorts-native", "remotion", "reference-only"]
      }
    },
    "license": {
      "type": "object",
      "required": ["spdxId", "author", "isCommercialAllowed"],
      "properties": {
        "spdxId": { "type": "string" },
        "author": { "type": "string" },
        "isCommercialAllowed": { "type": "boolean" },
        "attributionText": { "type": "string" }
      }
    },
    "qualificationStatus": {
      "type": "string",
      "enum": ["CANDIDATE", "CONTRACT_TESTED", "QUALIFIED", "DEPRECATED", "REJECTED"]
    }
  }
}
