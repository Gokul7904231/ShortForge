# ShortForge Notebook Render Fabric
# Secrets are never committed.

# Legacy/CI-only credentials.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Preferred ShortForge user connection fallback.
KAGGLE_API_TOKEN=

# Hosted web OAuth for ShortForge user connections.
# Kaggle public clients are localhost-only; hosted deployments should use an organization client.
KAGGLE_OAUTH_CLIENT_ID=
KAGGLE_OAUTH_CLIENT_TYPE=ORGANIZATION
KAGGLE_OAUTH_ORG_USERNAME=
KAGGLE_OAUTH_ORG_API_KEY=
# Optional when the app is behind a proxy:
KAGGLE_OAUTH_REDIRECT_URI=

# Colab uses an ephemeral access token when supplied explicitly.
# Local development may instead use Google Application Default Credentials (ADC).
COLAB_ACCESS_TOKEN=
COLAB_GCP_PROJECT_ID=shortforge-colab
COLAB_GCLOUD_ADC=1
COLAB_LIVE_GPU=T4
COLAB_LIVE_RENDER=0
COLAB_API_TIMEOUT_MS=30000
COLAB_ARTIFACT_TIMEOUT_MS=300000
COLAB_JUPYTER_PYTHON=python

PAPERSPACE_API_KEY=
PAPERSPACE_TEMPLATE_ID=
PAPERSPACE_MACHINE_TYPE=
PAPERSPACE_REGION=
PAPERSPACE_DISK_GB=50
PAPERSPACE_STARTUP_SCRIPT_ID=

LIGHTNING_USER_ID=
LIGHTNING_API_KEY=
LIGHTNING_TEAMSPACE=
LIGHTNING_TEAMSPACE=
LIGHTNING_MACHINE=CPU
LIGHTNING_PYTHON=python3

HF_ZEROGPU_SPACE=
HF_ZEROGPU_API_NAME=/predict
HF_TOKEN=

# Optional: bearer token for Kaggle's official remote MCP endpoint (KGAT...)
KAGGLE_MCP_TOKEN=

# ShortForge-owned Kaggle renderer profile (manual live proof only).
# PROOF is deterministic GPU work; model-backed modes require the corresponding
# Kaggle GPU runtime and may consume significant free GPU quota.
KAGGLE_RENDERER=SHORTFORGE_WAN_DUAL_T4
KAGGLE_WAN_PROFILE=PROOF
KAGGLE_WAN_PROMPT=
KAGGLE_WAN_STEPS=12
KAGGLE_WAN_NUM_FRAMES=21

# Optional: a deployed LitServe MCP endpoint (usually ends in /mcp/)
LIGHTNING_LITSERVE_MCP_URL=
# Optional: auth for the LitServe endpoint
LIGHTNING_LITSERVE_MCP_TOKEN=
LIGHTNING_LITSERVE_API_KEY=
