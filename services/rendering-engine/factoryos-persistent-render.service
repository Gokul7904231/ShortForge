[Unit]
Description=FactoryOS Persistent Basic FastAPI Render Service
After=network.target

[Service]
Type=simple
User=factoryos
WorkingDirectory=/opt/factoryos/rendering-engine
EnvironmentFile=/opt/factoryos/rendering-engine/.env
ExecStart=/usr/bin/python3 -m uvicorn basic_render_api:app --host 127.0.0.1 --port 8100 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=factoryos-persistent-render

# Security hardening
ProtectSystem=full
PrivateTmp=false

[Install]
WantedBy=multi-user.target
